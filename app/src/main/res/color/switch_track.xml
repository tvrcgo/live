<?xml version="1.0" encoding="utf-8"?>
<!-- 开关轨道配色显式声明：appcompat 首次给轨道注入 stateful tint 会失败，首个开关颜色将不随状态变化 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?android:attr/colorForeground" android:alpha="0.1" android:state_enabled="false" />
    <item android:color="?attr/colorControlActivated" android:alpha="0.3" android:state_checked="true" />
    <item android:color="?android:attr/colorForeground" android:alpha="0.3" />
</selector>
