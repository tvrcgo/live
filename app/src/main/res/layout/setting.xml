<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flat_panel"
    >

    <!-- 标题固定在滚动区外（leanback decor title），滚动只发生在列表区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/setting_row_padding_h"
        android:paddingEnd="@dimen/setting_row_padding_h"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="@string/title_settings"
        android:textColor="#FFEEEEEE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/source_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_sources"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/setting_chevron_text" />
        </LinearLayout>

        <!-- 整行聚焦：确认键即开关，开关纯显示 -->
        <LinearLayout
            android:id="@+id/row_channel_reversal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_channel_reversal"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/switch_channel_reversal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_channel_num"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_channel_num"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/switch_channel_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- 整行聚焦：确认/左右键切换选项，分段控件纯显示 -->
        <LinearLayout
            android:id="@+id/row_channel_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_channel_layout"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/channel_layout"
                android:layout_width="@dimen/channel_segment_width"
                android:layout_height="@dimen/channel_segment_height"
                android:background="@drawable/bg_layout_segment_group"
                android:clickable="false"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/channel_layout_horizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_layout_segment_item"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/channel_layout_horizontal"
                    android:textColor="@color/layout_segment_text"
                    android:textSize="@dimen/channel_segment_text" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/channel_divider" />

                <TextView
                    android:id="@+id/channel_layout_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_layout_segment_item"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/channel_layout_vertical"
                    android:textColor="@color/layout_segment_text"
                    android:textSize="@dimen/channel_segment_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_time"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/switch_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_boot_startup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_boot_startup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_boot_startup"
                    android:textColor="#FFEEEEEE"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/hint_boot_startup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hint_boot_startup_disabled"
                    android:textColor="#FF999999"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_boot_startup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/version_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_version"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/version_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3EEEEEE"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>
