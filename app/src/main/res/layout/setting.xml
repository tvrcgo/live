<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flat_panel"
    >

    <!-- 标题固定在滚动区外（leanback decor title），滚动只发生在列表区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h"
            android:text="@string/title_settings"
            android:textColor="#FFEEEEEE"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 标题与滚动区分隔线：主题粉 60% 通栏，上下留白对称 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="@color/focus_soft" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/source_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_sources"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/setting_chevron_text" />
        </LinearLayout>

        <!-- 整行聚焦：确认键即开关，开关纯显示 -->
        <LinearLayout
            android:id="@+id/row_channel_reversal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_channel_reversal"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_channel_reversal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_channel_num"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_channel_num"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_channel_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- 整行聚焦：确认/左右键切换选项，分段控件纯显示 -->
        <LinearLayout
            android:id="@+id/row_channel_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_channel_layout"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <!-- leanback ListPreference 同款：当前值 + 左右指示，行内左右键切换 -->
            <ImageView
                android:id="@+id/channel_layout_left"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/setting_chevron_text" />

            <TextView
                android:id="@+id/channel_layout_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:minWidth="40dp"
                android:duplicateParentState="true"
                android:gravity="center"
                android:textColor="#FFEEEEEE"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/channel_layout_right"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/setting_chevron_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_time"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_boot_startup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_boot_startup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_boot_startup"
                    android:textColor="#FFEEEEEE"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/hint_boot_startup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hint_boot_startup_disabled"
                    android:textColor="#FF999999"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_boot_startup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/version_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_setting_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/setting_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/setting_row_padding_h"
            android:paddingEnd="@dimen/setting_row_padding_h">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_version"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/version_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3EEEEEE"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>
