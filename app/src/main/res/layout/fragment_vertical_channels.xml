<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/channel_scrim">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/channel_rail_width"
                android:layout_height="match_parent"
                android:background="@color/channel_group_panel"
                android:orientation="vertical"
                android:paddingTop="@dimen/channel_content_padding"
                android:paddingBottom="@dimen/channel_content_padding">

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/group_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollbars="none" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/channel_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/channel_list_panel"
                android:orientation="vertical"
                android:paddingTop="@dimen/channel_content_padding"
                android:paddingBottom="@dimen/channel_content_padding">

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/channel_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50" />
    </LinearLayout>
</FrameLayout>
