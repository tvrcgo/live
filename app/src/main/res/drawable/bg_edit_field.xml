<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Material 输入框：暗底 + 底部 2dp 下划线，聚焦变主题色 -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/flat_row" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item android:gravity="bottom">
                <shape android:shape="rectangle">
                    <size android:height="2dp" />
                    <solid android:color="@color/source_field_focus" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/flat_row" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item android:gravity="bottom">
                <shape android:shape="rectangle">
                    <size android:height="2dp" />
                    <solid android:color="@color/channel_segment_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
